{
	"name": "pantheon",
	"version": "0.1.0",
	"private": true,
	"packageManager": "bun@1.3.11",
	"dependencies": {
		"@hexclave/next": "^1.0.99",
		"@neondatabase/serverless": "^1.1.0",
		"@vinext/cloudflare": "latest",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.32.0",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@hexclave/cli": "^1.0.99",
		"@tailwindcss/postcss": "latest",
		"@types/node": "^26.2.0",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "^4.124.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "bun run build && bun run start",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push"
	}
}